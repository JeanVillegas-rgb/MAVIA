# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enables AI image interpretation + storylike narration
# Without this key, Mavia uses template-based narration and generic image descriptions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Text-to-speech voice (Microsoft Edge neural voices via edge-tts)
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%

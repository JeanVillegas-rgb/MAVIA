# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used in verification email links
FRONTEND_URL=http://localhost:5173

# Email — leave blank to print verification links to the console.
# To send real mail (e.g. Gmail), set both and DEFAULT_FROM_EMAIL:
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
#   DEFAULT_FROM_EMAIL=MAVIA <you@gmail.com>
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

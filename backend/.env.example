# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_TIMEOUT=240
OLLAMA_VISION_TIMEOUT=300
OLLAMA_KEEP_ALIVE=10m
OLLAMA_VALIDATE_OUTLINE=False
ADAPTIVE_VARIANT_GENERATION_ENABLED=True
ADAPTIVE_VARIANT_LLM_MODEL=gemma3:4b
ADAPTIVE_VARIANT_TIMEOUT=240
MAX_PDF_IMAGES_FOR_VISION=2
MAX_PDF_TABLE_IMAGES=6
MIN_UNCAPTIONED_PDF_IMAGE_PAGE_RATIO=0.04

# Lesson PDF to course-outline topic validation
MATERIAL_TOPIC_COSINE_THRESHOLD=0.08
MATERIAL_TOPIC_BROAD_MATCH_RATIO=0.60
MATERIAL_TOPIC_MAX_BROAD_MATCHES=3
MATERIAL_SELECTED_TOPIC_COSINE_THRESHOLD=0.07
MATERIAL_SELECTED_TOPIC_BEST_SCORE_RATIO=0.40

# Deterministic learning-object chunk balancing
LEARNING_OBJECT_MIN_WORDS=8
LEARNING_OBJECT_MAX_WORDS=60
LEARNING_OBJECT_MERGE_COSINE_THRESHOLD=0.32

# Explainable cross-PDF learning-object matching. Weights are normalized at runtime.
LEARNING_OBJECT_MATCH_TITLE_WEIGHT=0.35
LEARNING_OBJECT_MATCH_CONTENT_WEIGHT=0.25
LEARNING_OBJECT_MATCH_CHARACTER_WEIGHT=0.20
LEARNING_OBJECT_MATCH_KEYWORD_WEIGHT=0.10
LEARNING_OBJECT_MATCH_STRUCTURE_WEIGHT=0.10
LEARNING_OBJECT_MATCH_AUTO_THRESHOLD=0.50
LEARNING_OBJECT_MATCH_REVIEW_THRESHOLD=0.30
LEARNING_OBJECT_MATCH_MINIMUM_MARGIN=0.08
LEARNING_OBJECT_MATCH_GROUP_MEMBER_THRESHOLD=0.45
LEARNING_OBJECT_MATCH_CONTENT_SUPPORT_THRESHOLD=0.30
# Question-to-learning-object matching. Weights are normalized at runtime.
QUESTION_PAIR_AUTO_THRESHOLD=0.55
QUESTION_PAIR_REVIEW_THRESHOLD=0.25
QUESTION_PAIR_LEXICAL_WEIGHT=0.70
QUESTION_PAIR_BLOCK_PROXIMITY_WEIGHT=0.20
QUESTION_PAIR_SAME_PAGE_WEIGHT=0.10

# Incoming web/mobile portal: verification is optional for local development.
EMAIL_VERIFICATION_REQUIRED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=noreply@mavia.local
# For actual delivery, select django.core.mail.backends.smtp.EmailBackend.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Optional local vision descriptions; teachers should review suggestions.
IMAGE_DESCRIPTION_ENABLED=True
IMAGE_DESCRIPTION_MODEL=gemma3:4b
IMAGE_DESCRIPTION_TIMEOUT=300

# Semantic learning-object grouping: high auto / medium teacher / low ignore.
SEMANTIC_GROUPING_MODE=auto
SEMANTIC_GROUPING_THREADS=2
SEMANTIC_GROUPING_AUTO_THRESHOLD=0.60
SEMANTIC_GROUPING_REVIEW_THRESHOLD=0.30
SEMANTIC_GROUPING_MINIMUM_SBERT_COSINE=0.60
SEMANTIC_GROUPING_MINIMUM_MARGIN=0.05
# Downloads only the pinned public model weights when they are not cached.
# Learning-object text is never sent to Hugging Face.
SEMANTIC_GROUPING_ALLOW_MODEL_DOWNLOAD=True
# Absolute path recommended; matching model fingerprint is required.
# SEMANTIC_GROUPING_CALIBRATION=C:/path/to/approved-grouping-evaluation.json
